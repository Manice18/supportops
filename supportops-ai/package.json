{
  "name": "supportops-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter @supportops/shared --filter @supportops/mock-data --filter @supportops/db --filter @supportops/investigation --filter @supportops/api --filter @supportops/mcp --filter @supportops/web build",
    "lint": "eslint apps/api packages && pnpm --filter @supportops/web lint",
    "typecheck": "pnpm -r --filter @supportops/shared --filter @supportops/mock-data --filter @supportops/db --filter @supportops/investigation --filter @supportops/api --filter @supportops/web typecheck",
    "dev": "pnpm --parallel --filter @supportops/api --filter @supportops/web --filter @supportops/mcp dev",
    "test": "pnpm --filter @supportops/api test",
    "db:generate": "pnpm --filter @supportops/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @supportops/db exec prisma migrate deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @supportops/db seed",
    "demo:reset": "dotenv -e .env -- pnpm --filter @supportops/db reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}

DATABASE_URL=postgresql://supportops:supportops@localhost:5433/supportops
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
API_PROXY_URL=http://localhost:4000
# The browser calls the Next.js app, which proxies /api and /health. Do not point
# browser fetches at the API port directly or the session cookie will be dropped.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Application session secret. Not an AgntID variable. Use a long random value locally.
SESSION_SECRET=replace-with-a-long-random-string
AI_PROVIDER_API_KEY=
# AgntID configuration: add exact official variables after documentation verification.
# AGNTID_...=
DEMO_MODE=true
MCP_PORT=4050
# Dev request logs. Defaults are supportops-ai/logs/api.log, logs/mcp.log, and logs/web.log.
# API_LOG_FILE=
# MCP_LOG_FILE=
# WEB_LOG_FILE=
# Shared secret the local AgntID runtime sends when it calls this MCP server.
# In the portal, reference it as MCP_AUTH_TOKEN=${MCP_AUTH_TOKEN}. Do not commit the value.
MCP_AUTH_TOKEN=
